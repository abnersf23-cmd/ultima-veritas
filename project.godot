; Arquivo de configuração do projeto Godot.
; Abra o Godot, clique em "Importar" e escolha este arquivo.

config_version=5

[application]

config/name="Ultima Veritas"
config/description="RPG de ação 2D lateral numa Roma que nunca caiu."
run/main_scene="res://scenes/test_level.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Controls="*res://scripts/controls.gd"
Dialogue="*res://scripts/dialogue_manager.gd"
DialogueBox="*res://scenes/dialogue_box.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[layer_names]

2d_physics/layer_1="mundo"
2d_physics/layer_2="jogador"
2d_physics/layer_3="inimigos"
2d_physics/layer_4="ataques_jogador"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.16, 0.18, 0.24, 1)
